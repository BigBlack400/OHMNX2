generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Content {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Admin {
  id       String @id @default(cuid())
  username String @unique
  password String
}
